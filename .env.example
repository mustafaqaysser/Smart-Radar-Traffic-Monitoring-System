# ─────────────────────────────────────────────────────────────────────────────
# Zill · ظل — environment
#
# `npm run setup` copies this file to .env and fills every "generated" secret.
# Everything runs with ZERO external accounts: each service below has a local
# fallback. Add real keys to switch a service on — no code changes required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
# Public origin of the site (no trailing slash). Used for links in emails,
# canonical URLs, sitemaps, OG images and Better Auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seeds the fictional demo world and shows a discreet "concept project" note
# in the footer. Set to false for a real restaurant.
DEMO_MODE=true

# ── Database (Drizzle + libSQL) ─────────────────────────────────────────────
# Local development: a SQLite file (created by `npm run setup`).
# Production (Turso): libsql://<db>-<org>.turso.io  +  DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/zill.db
DATABASE_AUTH_TOKEN=

# ── Authentication (Better Auth) ────────────────────────────────────────────
# 32+ random bytes, base64. Generated by `npm run setup`. Rotate to sign
# everybody out.
BETTER_AUTH_SECRET=generated
# Must equal NEXT_PUBLIC_SITE_URL in each environment.
BETTER_AUTH_URL=http://localhost:3000

# ── Email ───────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY every email is captured in the dev outbox
# (Admin → Outbox), rendered exactly as sent, OTP codes included.
RESEND_API_KEY=
# Sender for all transactional mail (must be a verified Resend domain).
EMAIL_FROM="Zill · ظل <hello@zill.test>"

# ── Payments ────────────────────────────────────────────────────────────────
# Without Stripe keys a built-in simulated provider handles card payments
# (use card 4242 4242 4242 4242; 4000 0000 0000 0002 simulates a decline).
# With test keys, Stripe's Payment Element (incl. Apple Pay / Google Pay) is used.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# ── File storage ────────────────────────────────────────────────────────────
# Without S3 settings, uploads are stored on disk in LOCAL_STORAGE_DIR and
# served from /files/*. With them, any S3-compatible store is used
# (Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto).
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (custom domain or r2.dev URL) for images.
STORAGE_PUBLIC_URL=

# ── Bot protection ──────────────────────────────────────────────────────────
# Honeypots and rate limits are always on. Add Cloudflare Turnstile keys to
# add a challenge to public forms.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── AI concierge (optional, off by default) ─────────────────────────────────
# The concierge appears only when the `aiConcierge` feature flag is on
# (Admin → Settings → Features) AND this key is set.
ANTHROPIC_API_KEY=
# Optional model override for the concierge.
CONCIERGE_MODEL=

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
# Generated by `npm run setup`.
CRON_SECRET=generated

# ── Privacy-friendly analytics ──────────────────────────────────────────────
# Salt for the daily-rotating visitor hash (no cookies, no IP storage).
# Generated by `npm run setup`.
ANALYTICS_SALT=generated

# ── Headless Chromium (menu PDFs, OG images) ────────────────────────────────
# Optional path to a Chromium/Chrome binary used at runtime by the admin's
# "Regenerate PDF / OG" actions. Build-time scripts find Playwright's browser
# automatically. See docs/DEPLOY.md for each hosting target.
CHROMIUM_EXECUTABLE_PATH=
